{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itrova",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // `wrangler deploy --env staging` publishes the staging branch to a SEPARATE worker, so a staging
  // deploy can never overwrite production. Bindings aren't inherited by environments, so the asset
  // and observability settings are repeated here deliberately. See STAGING.md.
  "env": {
    "staging": {
      "name": "itrova-staging",
      "observability": {
        "enabled": true
      },
      "assets": {
        "not_found_handling": "single-page-application"
      },
      "compatibility_flags": [
        "nodejs_compat"
      ]
    }
  }
}
